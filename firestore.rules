rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function businessOwnerId(businessId) {
      return get(
        /databases/$(database)/documents/businesses/$(businessId)
      ).data.ownerId;
    }

    function hasBusinessAccess(businessId) {
      return isSignedIn() && businessOwnerId(businessId) == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /items/{itemId} {
      allow create: if hasBusinessAccess(request.resource.data.businessId);
      allow read: if resource == null || hasBusinessAccess(resource.data.businessId);
      allow update, delete: if hasBusinessAccess(resource.data.businessId);
    }

    match /types/{typeId} {
      allow create: if hasBusinessAccess(request.resource.data.businessId);
      allow read: if resource == null || hasBusinessAccess(resource.data.businessId);
      allow update, delete: if hasBusinessAccess(resource.data.businessId);
    }

    match /tables/{tableId} {
      allow create: if hasBusinessAccess(request.resource.data.businessId);
      allow read: if resource == null || hasBusinessAccess(resource.data.businessId);
      allow update, delete: if hasBusinessAccess(resource.data.businessId);
    }

    match /orders/{orderId} {
      allow create: if hasBusinessAccess(request.resource.data.businessId);
      allow read: if resource == null || hasBusinessAccess(resource.data.businessId);
      allow update, delete: if hasBusinessAccess(resource.data.businessId);
    }

    match /split-orders/{splitOrderId} {
      allow create: if hasBusinessAccess(request.resource.data.businessId);
      allow read: if resource == null || hasBusinessAccess(resource.data.businessId);
      allow update, delete: if hasBusinessAccess(resource.data.businessId);
    }
  }
}
